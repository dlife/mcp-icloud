# Kopieer naar .env (chmod 600) en vul in. Nooit committen.
ICLOUD_APPLE_ID=jouw@icloud.com
# App-specifiek wachtwoord: account.apple.com > Aanmelden en beveiliging > App-specifieke wachtwoorden
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Publieke HTTPS-adres van de server (zonder slash op het eind)
MCP_PUBLIC_URL=https://icloud.example.com
# Hostnamen waarop de server bereikbaar is (kommagescheiden)
MCP_ALLOWED_HOSTS=icloud.example.com
# Wachtwoord (minstens 12 tekens) dat je invult als Claude de koppeling wil maken: openssl rand -base64 18
MCP_OWNER_PASSWORD=
# Optioneel, alleen voor curl-tests op de NAS: lange vaste token (openssl rand -hex 32). Leeg laten in gebruik.
MCP_AUTH_TOKEN=
